# heavy hero source — only the compressed hero.mp4/.webm are deployed
docs/media/*.mov

# git worktree mounts for hive worker agents — never commit (each is a separate branch checkout)
.worktrees/

# raw demo screen recordings — only the compressed docs/media/demo/*.mp4 are deployed
docs/media/MunderDifflin*.mp4
.vercel
.env*

# Local acceptance captures can contain personal app/account context. Publish
# written results and reproducible test tools, not raw private screenshots/logs.
/docs/reviews/assets/

# Keep new Mac source exports discoverable even with a global build/ ignore.
!/build/
/build/*
!/build/icon-macos.png
!/build/MACOS-ICON.md
